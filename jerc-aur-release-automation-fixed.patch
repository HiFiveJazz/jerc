diff --git a/.github/workflows/publish-aur.yml b/.github/workflows/publish-aur.yml
new file mode 100644
index 0000000..9a5fef8
--- /dev/null
+++ b/.github/workflows/publish-aur.yml
@@ -0,0 +1,99 @@
+name: Publish AUR packages
+
+on:
+  # Manual GitHub Releases trigger this event. Releases created by GITHUB_TOKEN
+  # don't, so release.yml also sends a repository_dispatch below.
+  release:
+    types: [published]
+  repository_dispatch:
+    types: [jerc_release_ready]
+  workflow_dispatch:
+    inputs:
+      tag:
+        description: 'Existing release tag (for example v0.6.1)'
+        type: string
+        required: true
+
+permissions:
+  contents: write
+
+concurrency:
+  group: jerc-aur-publish
+  cancel-in-progress: false
+
+jobs:
+  publish:
+    if: ${{ github.event_name != 'release' || !github.event.release.prerelease }}
+    runs-on: ubuntu-latest
+    container:
+      image: archlinux:base-devel
+    defaults:
+      run:
+        shell: bash
+    steps:
+      - name: Install tools
+        run: pacman -Syu --noconfirm --needed git openssh curl
+
+      - name: Check out packaging sources
+        uses: actions/checkout@v4
+        with:
+          ref: main
+          persist-credentials: true
+
+      - name: Generate release PKGBUILDs and .SRCINFO
+        env:
+          RELEASE_TAG: ${{ github.event.release.tag_name || github.event.client_payload.tag || inputs.tag }}
+        run: |
+          set -euo pipefail
+          # makepkg refuses to run as root, even when printing metadata.
+          useradd --create-home aur-builder
+          chown -R aur-builder:aur-builder packaging/aur
+          runuser -u aur-builder -- ./scripts/update-aur-release.sh "$RELEASE_TAG"
+
+      - name: Commit packaging metadata to GitHub
+        env:
+          RELEASE_TAG: ${{ github.event.release.tag_name || github.event.client_payload.tag || inputs.tag }}
+        run: |
+          set -euo pipefail
+          git config --global --add safe.directory "$GITHUB_WORKSPACE"
+          git config user.name 'github-actions[bot]'
+          git config user.email '41898282+github-actions[bot]@users.noreply.github.com'
+          for name in jerc-bin jerc; do
+            if [[ -f "packaging/aur/$name/PKGBUILD" ]]; then
+              git add "packaging/aur/$name/PKGBUILD"
+              git add -f "packaging/aur/$name/.SRCINFO"
+            fi
+          done
+          if ! git diff --cached --quiet; then
+            git commit -m "Update AUR packages for $RELEASE_TAG"
+            git push origin HEAD:main
+          fi
+
+      - name: Publish binary package to AUR
+        env:
+          AUR_SSH_PRIVATE_KEY: ${{ secrets.AUR_SSH_PRIVATE_KEY }}
+          AUR_SSH_KNOWN_HOSTS: ${{ secrets.AUR_SSH_KNOWN_HOSTS }}
+          GIT_AUTHOR_NAME: HiFiveJazz
+          GIT_AUTHOR_EMAIL: aur@users.noreply.github.com
+          GIT_COMMITTER_NAME: HiFiveJazz
+          GIT_COMMITTER_EMAIL: aur@users.noreply.github.com
+        run: |
+          set -euo pipefail
+          [[ -n "$AUR_SSH_PRIVATE_KEY" && -n "$AUR_SSH_KNOWN_HOSTS" ]] || {
+            echo 'Missing AUR_SSH_PRIVATE_KEY or AUR_SSH_KNOWN_HOSTS secret' >&2
+            exit 1
+          }
+          install -d -m 700 "$HOME/.ssh"
+          printf '%s\n' "$AUR_SSH_PRIVATE_KEY" > "$HOME/.ssh/id_ed25519"
+          printf '%s\n' "$AUR_SSH_KNOWN_HOSTS" > "$HOME/.ssh/known_hosts"
+          chmod 600 "$HOME/.ssh/id_ed25519" "$HOME/.ssh/known_hosts"
+          ./scripts/publish-aur.sh jerc-bin
+
+      - name: Publish source package to AUR (opt-in)
+        if: ${{ vars.AUR_PUBLISH_SOURCE == 'true' }}
+        env:
+          GIT_AUTHOR_NAME: HiFiveJazz
+          GIT_AUTHOR_EMAIL: aur@users.noreply.github.com
+          GIT_COMMITTER_NAME: HiFiveJazz
+          GIT_COMMITTER_EMAIL: aur@users.noreply.github.com
+        run: ./scripts/publish-aur.sh jerc
